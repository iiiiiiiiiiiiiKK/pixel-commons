# Pixel Commons — environment variables
#
# Copy to `.dev.vars` for local `wrangler dev`, and set the same names as
# Cloudflare secrets/vars in production. Never commit real values.

# REQUIRED — HMAC secret used to sign anonymous session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# OPTIONAL — enables the admin console. Leave empty to disable admin entirely.
ADMIN_TOKEN=

# OPTIONAL — extra origins allowed to call the API with credentials
# (comma separated). Needed when the UI is served from a different origin,
# e.g. the static GitHub Pages build talking to the Worker.
ALLOWED_ORIGINS=https://YOURNAME.github.io

# OPTIONAL — canvas geometry, name, palette and cooldown (defaults shown).
CANVAS_WIDTH=256
CANVAS_HEIGHT=256
CANVAS_NAME=Pixel Commons
COOLDOWN_SECONDS=30
# CANVAS_PALETTE=#000000,#1d2b53,#7e2553,#008751,#ab5236,#5f574f,#c2c3c7,#fff1e8,#ff004d,#ffa300,#ffec27,#00e436,#29adff,#83769c,#ff77a8,#ffccaa
